# Local Expo Go / emulator: PC LAN IP (not localhost) when testing on a phone
EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Live EAS builds: public https URL of the hosted FINPA backend (Render/Railway/etc.)
# Set this in Expo → Project → Environment variables (or eas.json env), not a LAN IP.
# EXPO_PUBLIC_API_URL=https://finpa-api.onrender.com

# Supabase Auth (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: force demo API/PIN chrome in a release build (never for store builds)
# EXPO_PUBLIC_SHOW_DEV_UI=1
