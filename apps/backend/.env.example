PORT=3001
OPENROUTER_API_KEY=sk-or-v1-your-key
# Must be a free-tier OpenRouter model (ends with :free). Backend-env only.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that can manage PINs in the app
SUPERADMIN_EMAILS=you@example.com
# Demo / review PINs (FINPA-DEMO-*) — default off in production
ALLOW_DEMO_PINS=false
