{
  "name": "finpa",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@finpa/backend",
    "dev:mobile": "npm run start --workspace=@finpa/mobile",
    "generate-pins": "npm run generate-pins --workspace=@finpa/backend",
    "build:backend": "npm run build --workspace=@finpa/backend",
    "test": "npm run test --workspace=@finpa/backend --",
    "eas:login": "npm run eas:login --workspace=@finpa/mobile",
    "eas:build:apk": "npm run eas:build:apk --workspace=@finpa/mobile",
    "supabase:check": "node scripts/check-supabase.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
